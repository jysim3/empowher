---
import { getCollection, render } from 'astro:content';
import OrgPage from '../../components/OrgPage.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
export async function getStaticPaths() {
  return (await getCollection('programs')).map((program) => ({ params: { slug: program.id }, props: { program } }));
}
const { program } = Astro.props;
const { Content } = await render(program);
const galleries = await getCollection('galleries');
const gallery = program.data.gallery ? galleries.find((item) => item.id === program.data.gallery) : undefined;
const events = await getCollection('events');
const related = program.data.relatedEvents?.map((slug: string) => events.find((event) => event.id === slug)).filter(Boolean) ?? [];
---
<OrgPage title={program.data.title} label={program.data.label} lede={program.data.lede}>
  {program.data.details && <dl class="programme-details section" aria-label="Event details">{program.data.details.map((detail) => <div><dt class="label">{detail.label}</dt><dd>{detail.url ? <a class="text-link" href={detail.url}>{detail.value}</a> : detail.value}</dd></div>)}</dl>}
  <section class="section programme-detail">
    <div>
      <div class="org-prose"><Content /></div>
      {program.data.structuredSections?.map((section) => <section class="programme-rows"><h2>{section.title}</h2><div>{section.items.map((item) => <article><h3>{item.url ? <a class="text-link" href={item.url}>{item.name}</a> : item.name}</h3><p>{item.description}</p></article>)}</div></section>)}
      {program.data.schedule && <section class="programme-schedule"><h2>Event schedule</h2><div>{program.data.schedule.map((item) => <article><p class="label">{item.time}</p><p>{item.description}</p></article>)}</div></section>}
    </div>
    {related.length > 0 && <aside class="related-events" aria-labelledby="related-events-title"><h2 id="related-events-title">Related events</h2><ul>{related.map((event) => <li><a class="text-link" href={`/events/${event!.id}`}>{event!.data.title}</a></li>)}</ul></aside>}
  </section>
  {gallery && <section class="section"><PhotoGallery title={`${program.data.title} photos`} photos={gallery.data.photos} /></section>}
</OrgPage>
