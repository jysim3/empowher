---
import { getEntry, render } from 'astro:content'; import OrgPage from '../components/OrgPage.astro'; import { withBase } from '../lib/url'; const page=await getEntry('pages','womens-health'); if(!page) throw new Error('Missing health content'); const {Content}=await render(page);
---
<OrgPage title={page.data.title} label="Health and safety" lede={page.data.lede}><section class="section org-prose"><Content /><p><a class="text-link" href={withBase('/resources')}>Browse health guides and checklists</a></p></section></OrgPage>
