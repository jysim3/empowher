---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issueNumber - a.data.issueNumber);
const formatMonth = (month: string) => {
  const [year, monthNumber] = month.split('-').map(Number);
  return new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(Date.UTC(year, monthNumber - 1)));
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Read every free digital issue of EmpowHER Magazine." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EmpowHER Magazine · EmpowHER Sydney</title>
  </head>
  <body>
    <Header primaryJoin={false} />
    <main>
      <section class="section page-intro stack" aria-labelledby="magazine-page-title">
        <span class="eyebrow label">Read, grow, connect</span>
        <h1 id="magazine-page-title">EmpowHER Magazine</h1>
        <p class="lede">Packed with inspiration, real stories, and practical tools designed to empower you in both your personal and professional life. Discover holistic wellness and self-care, career and small business strategies, community highlights and inspirational features.</p>
        <p><strong>The digital edition is completely free</strong></p>
      </section>

      <section class="section" aria-labelledby="issues-title">
        <h2 id="issues-title" class="issue-list-title">Issues</h2>
        <ol class="magazine-issues">
          {issues.map(({ data }) => (
            <li>
              <figure class="issue-cover">
                <Image src={data.cover} alt={data.title} widths={[280, 440, 660]} sizes="(max-width: 899px) 100vw, 33vw" />
                <figcaption>
                  <h3>Issue {data.issueNumber}</h3>
                  {data.date && <time datetime={data.date}>{formatMonth(data.date)}</time>}
                  <a class="text-link" href={data.issuuUrl}>Read issue {data.issueNumber}</a>
                </figcaption>
              </figure>
            </li>
          ))}
        </ol>
        <p class="coming-soon"><span class="label">Coming soon</span> Issue 4 coming soon: 26.11.26</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
