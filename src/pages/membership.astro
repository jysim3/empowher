---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);
const wixPlansUrl = 'https://www.empowhersydney.com/pricing-plans/list';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Compare EmpowHER Sydney's Bronze, Silver and Gold yearly membership plans." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Membership · EmpowHER Sydney</title>
  </head>
  <body>
    <Header primaryJoin={false} />
    <main>
      <section class="section page-intro stack" aria-labelledby="membership-title">
        <span class="eyebrow label">Join the growing community</span>
        <h1 id="membership-title">Membership</h1>
        <p class="lede">Welcome to EmpowHER membership Women Club. Connect with a supportive community and choose the yearly membership that suits you.</p>
      </section>

      <section class="section" aria-label="Yearly membership plans">
        <ol class="membership-plans">
          {plans.map(({ data }) => (
            <li class="membership-plan">
              <h2 class="label">{data.name}</h2>
              <p class="membership-price">${data.yearlyPrice} <small>a year</small></p>
              <p>{data.description}</p>
              <ul class="membership-benefits">
                {data.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>
              <a class="text-link" href={data.checkoutUrl}>Choose {data.name}</a>
            </li>
          ))}
        </ol>
        <div class="membership-action">
          <a class="button" href={wixPlansUrl}>Join on the current site</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
