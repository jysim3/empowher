---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cover from '../components/Cover.astro';
import EventRow from '../components/EventRow.astro';
import MemberGrid from '../components/MemberGrid.astro';
import { siteSettings } from '../data/site';
import coffee from '../assets/coffee.jpg';
import '../styles/tokens.css';
import '../styles/global.css';

const allEvents = await getCollection('events');
const now = new Date();
const upcomingEvents = allEvents
  .filter(({ data }) => data.start && data.start >= now && data.status !== 'cancelled')
  .sort((a, b) => a.data.start!.valueOf() - b.data.start!.valueOf());
const events = (upcomingEvents.length > 0
  ? upcomingEvents
  : allEvents.filter(({ data }) => data.start).sort((a, b) => b.data.start!.valueOf() - a.data.start!.valueOf())
).slice(0, 3);
const members = (await getCollection('members'))
  .filter(({ data }) => data.featuredOnHome)
  .sort((a, b) => a.data.order - b.data.order);
const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);
const issues = (await getCollection('issues')).sort((a, b) => a.data.issueNumber - b.data.issueNumber);
const { hero, highlights, quote, joinUrl, magazineUrl, eventsUrl, aboutUrl } = siteSettings;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="EmpowHER Sydney is a safe and supportive women's network where women connect, grow and achieve their dreams together." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EmpowHER Sydney · Women supporting women</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="section hero" aria-labelledby="home-title">
        <div class="hero-copy stack">
          <span class="eyebrow label">{hero.eyebrow}</span>
          <h1 id="home-title">{hero.headline} <i>{hero.headlineEmphasis}</i></h1>
          <p class="lede">{hero.lede}</p>
          <div class="actions"><a class="button" href={joinUrl}>Join now</a><a class="text-link" href={aboutUrl}>Learn more</a></div>
        </div>
        <Cover />
        <ul class="highlights">{highlights.map(({ title, text, href }) => <li><strong>{title}</strong>{href ? <a href={href}>{text}</a> : <span>{text}</span>}</li>)}</ul>
      </section>

      <section class="section" aria-labelledby="events-title">
        <div class="section-head"><h2 id="events-title">Events</h2><a class="text-link desktop-only" href={eventsUrl}>See all events</a></div>
        <div class="event-layout">
          <ul class="events">{events.map((event) => <EventRow event={event} />)}</ul>
          <figure class="event-photo"><Image src={coffee} alt="A large group of women waving at an EmpowHER coffee meetup" widths={[540, 800]} sizes="(max-width: 899px) 100vw, 50vw" /><figcaption>Coffee Meetup at Cafe Botanica, Rhodes. Last Saturday every month.</figcaption></figure>
        </div>
        <a class="text-link phone-only" href={eventsUrl}>See all events</a>
      </section>

      <section class="section" aria-labelledby="women-title">
        <div class="section-head"><h2 id="women-title"><a href="/women">EmpowHER Women</a></h2><span class="eyebrow label">For every woman, every dream, every stage of life</span></div>
        <MemberGrid members={members} />
      </section>

      <section class="section magazine" aria-labelledby="magazine-title">
        <div class="stack"><h2 id="magazine-title">The magazine</h2><p class="lede">Holistic wellness, career and small business strategies, community highlights and inspirational features. The digital edition is completely free.</p><a class="text-link" href={magazineUrl}>Read the magazine</a></div>
        <div class="issues">{issues.map(({ data }) => <a href={data.issuuUrl}><Image src={data.cover} alt={data.title} widths={[120, 190, 380]} sizes="(max-width: 899px) 30vw, 190px" /></a>)}</div>
      </section>

      <section class="section" aria-labelledby="membership-title">
        <div class="section-head"><h2 id="membership-title">Join the growing community</h2><span class="eyebrow label">Membership, yearly</span></div>
        <ul class="plans">{plans.map(({ data }) => <li><a href="/membership" aria-label={`Learn about ${data.name} membership`}><strong>{data.name}</strong><span class="price">${data.yearlyPrice} <small>a year</small></span><span class="summary">{data.summary}</span><ul>{data.summaryBenefits.map((benefit) => <li>{benefit}</li>)}</ul></a></li>)}</ul>
      </section>

      <section class="section closing" aria-label="Quote and newsletter">
        <blockquote><p>{quote.text}</p><cite class="label">{quote.attribution}</cite></blockquote>
        <form class="newsletter" action="https://www.empowhersydney.com" method="get"><label class="label" for="email">Subscribe to our newsletter</label><div><input id="email" type="email" name="email" autocomplete="email" placeholder="Enter your email here" required /><button class="text-link" type="submit">Subscribe</button></div></form>
      </section>
    </main>
    <Footer />
  </body>
</html>
