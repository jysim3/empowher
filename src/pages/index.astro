---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { Image } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cover from '../components/Cover.astro';
import { events, issues, members, plans } from '../data/home';
import coffee from '../assets/coffee.jpg';
import sharonSmall from '../assets/sharon-s.jpg';
import tina from '../assets/tina.jpg';
import jacq from '../assets/jacq.jpg';
import rachel from '../assets/rachel.jpg';
import vincenza from '../assets/vincenza.jpg';
import mag1 from '../assets/mag1.jpg';
import mag2 from '../assets/mag2.jpg';
import mag3 from '../assets/mag3.jpg';
import '../styles/tokens.css';
import '../styles/global.css';

const memberImages = { 'sharon-s': sharonSmall, tina, jacq, rachel, vincenza };
const issueImages = { mag1, mag2, mag3 };
const joinUrl = 'https://www.empowhersydney.com/pricing-plans/list';
const magazineUrl = 'https://www.empowhersydney.com/empowher-magazine';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="EmpowHER Sydney is a safe and supportive women's network where women connect, grow and achieve their dreams together." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>EmpowHER Sydney · Women supporting women</title>
  </head>
  <body>
    <Header />
    <main>
      <section class="section hero" aria-labelledby="home-title">
        <div class="hero-copy stack">
          <span class="eyebrow label">A women's network · Sydney Inc.</span>
          <h1 id="home-title">Empowering women. <i>Building futures.</i></h1>
          <p class="lede">At EmpowHER, we create a safe and supportive space where women can connect, grow, and achieve their dreams together. Join us and be part of a movement that's changing the world, one woman at a time.</p>
          <div class="actions"><a class="button" href={joinUrl}>Join now</a><a class="text-link" href="https://www.empowhersydney.com/about-us">Learn more</a></div>
        </div>
        <Cover />
        <ul class="highlights">
          <li><strong>Event highlight</strong><span>Empowering Wellness Expo, a free day for the whole family</span></li>
          <li><strong>Coffee meetup</strong><span>Last Saturday every month, women only</span></li>
          <li><strong>Membership</strong><span>Bronze, Silver and Gold from $20 a year</span></li>
        </ul>
      </section>

      <section class="section" aria-labelledby="events-title">
        <div class="section-head"><h2 id="events-title">Events</h2><a class="text-link desktop-only" href="https://www.empowhersydney.com/event-list">See all events</a></div>
        <div class="event-layout">
          <ul class="events">{events.map((event) => <li><a href={event.url}><time class="event-date"><span>{event.day}</span><small>{event.meta}</small></time><span class="event-copy"><strong>{event.title}</strong><span>{event.place}. {event.detail}</span></span><span class="arrow" aria-hidden="true">→</span></a></li>)}</ul>
          <figure class="event-photo"><Image src={coffee} alt="A large group of women waving at an EmpowHER coffee meetup" widths={[540, 800]} sizes="(max-width: 899px) 100vw, 50vw" /><figcaption>Coffee Meetup at Cafe Botanica, Rhodes. Last Saturday every month.</figcaption></figure>
        </div>
        <a class="text-link phone-only" href="https://www.empowhersydney.com/event-list">See all events</a>
      </section>

      <section class="section" aria-labelledby="women-title">
        <div class="section-head"><h2 id="women-title">EmpowHER Women</h2><span class="eyebrow label">For every woman, every dream, every stage of life</span></div>
        <div class="member-row">{members.map((member) => <figure><Image src={memberImages[member.image as keyof typeof memberImages]} alt={`Portrait of ${member.name}`} widths={[132, 260, 420]} sizes="(max-width: 899px) 132px, 20vw" /><figcaption><strong>{member.name}</strong><span>{member.role}</span></figcaption></figure>)}</div>
      </section>

      <section class="section magazine" aria-labelledby="magazine-title">
        <div class="stack"><h2 id="magazine-title">The magazine</h2><p class="lede">Holistic wellness, career and small business strategies, community highlights and inspirational features. The digital edition is completely free.</p><a class="text-link" href={magazineUrl}>Read the magazine</a></div>
        <div class="issues">{issues.map((issue) => <a href={magazineUrl}><Image src={issueImages[issue.image as keyof typeof issueImages]} alt={issue.title} widths={[120, 190, 380]} sizes="(max-width: 899px) 30vw, 190px" /></a>)}</div>
      </section>

      <section class="section" aria-labelledby="membership-title">
        <div class="section-head"><h2 id="membership-title">Join the growing community</h2><span class="eyebrow label">Membership, yearly</span></div>
        <ul class="plans">{plans.map((plan) => <li><a href={joinUrl} aria-label={`Join ${plan.name} membership`}><strong>{plan.name}</strong><span class="price">{plan.price} <small>a year</small></span><span class="summary">{plan.summary}</span><ul>{plan.benefits.map((benefit) => <li>{benefit}</li>)}</ul></a></li>)}</ul>
      </section>

      <section class="section closing" aria-label="Quote and newsletter">
        <blockquote><p>“Behind every great woman... is another great woman.”</p><cite class="label">Kate Hodges</cite></blockquote>
        <form class="newsletter" action="https://www.empowhersydney.com" method="get"><label class="label" for="email">Subscribe to our newsletter</label><div><input id="email" type="email" name="email" autocomplete="email" placeholder="Enter your email here" required /><button class="text-link" type="submit">Subscribe</button></div></form>
      </section>
    </main>
    <Footer />
  </body>
</html>
