---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { getCollection } from 'astro:content';
import BlogRow from '../../components/BlogRow.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import '../../styles/tokens.css';
import '../../styles/global.css';

const categoryNames: Record<string, string> = {
  'personal-growth': 'Personal Growth', 'building-connections': 'Building Connections',
  'women-in-leadership': 'Women in Leadership', 'redefining-success': 'Redefining Success',
  'coffee-meetup': 'Coffee Meetup', magazine: 'Magazine',
};
const posts = (await getCollection('posts')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<meta name="description" content="News, ideas and community stories from EmpowHER Sydney." /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>Blog · EmpowHER Sydney</title></head><body><Header primaryJoin={false} /><main>
  <section class="section page-intro stack" aria-labelledby="blog-title"><span class="eyebrow label">Stories and news</span><h1 id="blog-title">Blog</h1></section>
  <section class="section" aria-label="Blog posts">
    <nav class="blog-categories" aria-label="Blog categories"><a class="text-link" href="/blog">All posts</a>{Object.entries(categoryNames).map(([slug, name]) => <a class="text-link" href={`/blog/category/${slug}`}>{name}</a>)}</nav>
    <ol class="events blog-list">{posts.map((post) => <BlogRow post={post} categoryNames={categoryNames} />)}</ol>
  </section>
</main><Footer /></body></html>
