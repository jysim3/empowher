---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import { getCollection } from 'astro:content';
import EventRow from '../../components/EventRow.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { siteSettings } from '../../data/site';
import '../../styles/tokens.css';
import '../../styles/global.css';

const now = new Date();
const allEvents = await getCollection('events');
const datedEvents = allEvents.filter((event) => event.data.start);
const upcoming = datedEvents
  .filter(({ data }) => data.start! >= now)
  .sort((a, b) => a.data.start!.valueOf() - b.data.start!.valueOf());
const past = datedEvents
  .filter(({ data }) => data.start! < now)
  .sort((a, b) => b.data.start!.valueOf() - a.data.start!.valueOf());
const undated = allEvents.filter((event) => !event.data.start);
const pastByYear = new Map<number, typeof past>();
for (const event of past) {
  const timeZone = event.data.locality === 'Hong Kong' ? 'Asia/Hong_Kong' : 'Australia/Sydney';
  const year = Number(new Intl.DateTimeFormat('en-AU', { year: 'numeric', timeZone }).format(event.data.start!));
  pastByYear.set(year, [...(pastByYear.get(year) ?? []), event]);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Browse upcoming and past EmpowHER Sydney events." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Events · EmpowHER Sydney</title>
  </head>
  <body>
    <Header />
    <main>
      <header class="section page-intro stack">
        <span class="eyebrow label">What’s on</span>
        <h1>Events</h1>
        <p class="lede">Connect, learn and grow with EmpowHER Sydney. Browse what is coming up and what our community has shared together.</p>
      </header>
      <section class="section event-archive" aria-labelledby="upcoming-title">
        <h2 id="upcoming-title">Upcoming</h2>
        {upcoming.length > 0 ? <ul class="events">{upcoming.map((event) => <EventRow event={event} />)}</ul> : (
          <p class="empty-state">No upcoming events right now. <a class="text-link" href={siteSettings.joinUrl}>Explore membership</a>.</p>
        )}
      </section>
      <section class="section event-archive" aria-labelledby="past-title">
        <h2 id="past-title">Past events</h2>
        {[...pastByYear].map(([year, events]) => (
          <section class="event-year" aria-labelledby={`events-${year}`}>
            <h3 class="label" id={`events-${year}`}>{year}</h3>
            <ul class="events">{events.map((event) => <EventRow event={event} />)}</ul>
          </section>
        ))}
        {undated.length > 0 && (
          <section class="event-year" aria-labelledby="events-tbc">
            <h3 class="label" id="events-tbc">Date to be confirmed</h3>
            <ul class="events">{undated.map((event) => <EventRow event={event} />)}</ul>
          </section>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
