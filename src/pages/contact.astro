---
import { getEntry, render } from 'astro:content'; import OrgPage from '../components/OrgPage.astro'; const page=await getEntry('pages','contact'); if(!page) throw new Error('Missing contact content'); const {Content}=await render(page);
---
<OrgPage title={page.data.title} label="Reach out" lede="You are not alone. You matter. You are stronger than you think.">
  <section class="section org-prose"><Content /></section>
  <section class="section"><dl class="member-details contact-details">
    <div><dt class="label">Email</dt><dd><a class="text-link" href="mailto:women@empowhersydney.com">women@empowhersydney.com</a><br /><a class="text-link" href="mailto:sponsorship@empowhersydney.com">sponsorship@empowhersydney.com</a></dd></div>
    <div><dt class="label">Social Media</dt><dd><a class="text-link" href="https://www.facebook.com/groups/empowhersydney">Facebook</a><br /><a class="text-link" href="https://www.instagram.com/empowhersydney">Instagram</a></dd></div>
  </dl><p class="contact-form-link"><a class="text-link" href="https://www.empowhersydney.com/contactus">Open the contact form on the EmpowHER Sydney website</a></p></section>
</OrgPage>
