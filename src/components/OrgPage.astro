---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import '@fontsource/oswald/500.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Head from './Head.astro';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props { title: string; label: string; lede?: string; description?: string; }
const { title, label, lede, description = lede ?? title } = Astro.props;
---
<!doctype html>
<html lang="en"><head><Head title={`${title} · EmpowHER Sydney`} description={description} /></head><body><Header /><main>
<header class="section page-intro stack"><span class="eyebrow label">{label}</span><h1>{title}</h1>{lede && <p class="lede org-lede">{lede}</p>}</header>
<slot /></main><Footer /></body></html>
